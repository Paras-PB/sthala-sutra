# Copy to .env in the repository root. `docker compose up --build` (run from the root)
# reads this file to fill ${VAR} values in compose.yaml; empty values fall back to the
# compose defaults (local Postgres, local Redis, default models).
#
# Backend runtime: use the Supabase Session pooler connection URL for hosted deployments.
# Keep the database password server-side and never put it in a NEXT_PUBLIC_* variable.
# Compose passes DATABASE_URL only to the api and worker containers, never to web.
APP_ENV=development
# Empty uses a safe APP_ENV-derived default: schema creation in development, migrations in production.
AUTO_CREATE_SCHEMA=
# Empty uses the bundled local database (db service).
DATABASE_URL=
CELERY_BROKER_URL=redis://redis:6379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Only used when running the backend outside Docker; compose always uses /app/uploads.
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
HERITAGE_API_URL=http://api:8000
# Free Google AI Studio key for the optional, source-grounded heritage guide (web container only).
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: direct browser-to-API calls. Set this to the public HTTPS API URL on Vercel
# when you need uploads larger than Vercel Functions' 4.5 MB request limit.
NEXT_PUBLIC_API_URL=
# Hugging Face translation model. The worker passes NLLB language codes (hin_Deva, guj_Gujr,
# eng_Latn), so a replacement must accept them. NLLB-200 is CC-BY-NC 4.0 (non-commercial).
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
# Must produce 384-dimensional vectors to match the passages.embedding vector(384) column.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
