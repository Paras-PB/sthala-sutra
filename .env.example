# Backend runtime: use the Supabase Session pooler connection URL for hosted deployments.
# Keep the database password server-side and never put it in a NEXT_PUBLIC_* variable.
DATABASE_URL=
CELERY_BROKER_URL=redis://redis:6379/0
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional Hugging Face model id, e.g. Helsinki-NLP/opus-mt-hi-en.
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
