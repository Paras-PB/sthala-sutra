# Backend runtime: use the Supabase Session pooler connection URL for hosted deployments.
# Keep the database password server-side and never put it in a NEXT_PUBLIC_* variable.
APP_ENV=development
# Empty uses a safe APP_ENV-derived default: schema creation in development, migrations in production.
AUTO_CREATE_SCHEMA=
DATABASE_URL=
CELERY_BROKER_URL=redis://redis:6379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
HERITAGE_API_URL=http://api:8000
# Free Google AI Studio key for the optional, source-grounded heritage guide.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: direct browser-to-API calls. Set this to the public HTTPS API URL on Vercel
# when you need uploads larger than Vercel Functions' 4.5 MB request limit.
NEXT_PUBLIC_API_URL=
# Optional Hugging Face model id, e.g. Helsinki-NLP/opus-mt-hi-en.
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
